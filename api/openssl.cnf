# Konfigurasi OpenSSL untuk runtime Vercel (PHP 8.5 / OpenSSL 3.5.1).
#
# Masalah: OpenSSL 3.5 mengaktifkan key exchange post-quantum (X25519MLKEM768)
# secara default di TLS 1.3. Server MongoDB Atlas menolak ClientHello dengan
# group PQ tersebut ("tlsv1 alert internal error" - terverifikasi via /diag).
#
# Solusi: batasi grup key exchange ke klasik. Diaktifkan lewat env var project
# Vercel: OPENSSL_CONF=/var/task/user/api/openssl.cnf (bukan reserved var AWS
# Lambda, jadi sampai ke runtime).
#
# Efek samping: berlaku untuk semua outbound TLS di proses PHP (curl, dll) -
# grup klasik ini kompatibel dengan semua server modern.

openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
Groups = X25519:P-256:P-384
