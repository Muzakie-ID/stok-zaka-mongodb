{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": "npm install && npm run build && mkdir -p vercel-static && cp -r public/build vercel-static/build",
    "installCommand": null,
    "outputDirectory": "vercel-static",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "maxDuration": 30,
            "excludeFiles": "{node_modules/**,vercel-static/**}"
        },
        "api/diag.php": {
            "runtime": "vercel-php@0.9.0",
            "maxDuration": 30,
            "excludeFiles": "{node_modules/**,vercel-static/**,vendor/**,app/**,resources/**,database/**,config/**,routes/**,storage/**}"
        }
    },
    "rewrites": [
        { "source": "/diag", "destination": "/api/diag.php" },
        { "source": "/((?!build/).*)", "destination": "/api/index.php" }
    ]
}
